# Local PostgreSQL used by Docker Compose and the API.
POSTGRESQL_VERSION=17
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=replace-for-local-development
POSTGRESQL_DATABASE=codev_osrs_db

# Required by the API's session signing and Google sign-in.
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_EXPIRES_IN=8h
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_ALLOWED_DOMAIN=example.com

# Comma-separated; matching accounts are assigned the admin role.
ADMIN_EMAILS=

# SMTP is verified during application startup. Use a local SMTP sink or
# development SMTP account; do not use production credentials here.
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=replace-with-local-smtp-password
SMTP_DEFAULT_FROM=CoDev OSRS <noreply@example.com>
PORTAL_URL=http://localhost:5173

# Optional. Comma-separated browser origins; unset allows any origin.
CORS_ORIGINS=http://localhost:5173
PORT=3000
